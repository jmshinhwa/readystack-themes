{
  "name": "loeschkonzept-fristen-lint",
  "displayName": "Aufbewahrungsfristen-Lint für Löschkonzepte",
  "description": "Findet falsche Aufbewahrungsfristen im Löschkonzept: Buchungsbelege 8 statt 10 Jahre seit BEG IV, Fristbeginn, unbegrenzte Speicherung, Bewerberdaten. 10 rules, offline.",
  "version": "1.0.4",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "Löschkonzept",
    "Aufbewahrungsfristen",
    "DSGVO",
    "BEG IV",
    "147 AO",
    "257 HGB",
    "Datenschutz",
    "Loeschkonzept"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "loeschkonzeptFristen.checkFile",
        "title": "Aufbewahrungsfristen-Lint für Löschkonzepte (BEG IV): Check this file",
        "category": "Aufbewahrungsfristen-Lint für Löschkonzepte (BEG IV)"
      },
      {
        "command": "loeschkonzeptFristen.checkWorkspace",
        "title": "Aufbewahrungsfristen-Lint für Löschkonzepte (BEG IV): Sweep workspace and write report (licence)",
        "category": "Aufbewahrungsfristen-Lint für Löschkonzepte (BEG IV)"
      },
      {
        "command": "loeschkonzeptFristen.enterKey",
        "title": "Aufbewahrungsfristen-Lint für Löschkonzepte (BEG IV): Enter licence key",
        "category": "Aufbewahrungsfristen-Lint für Löschkonzepte (BEG IV)"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "loeschkonzept-fristen-lint"
  },
  "homepage": "https://getreadystack.com/de/tools/loeschkonzept-fristen-lint",
  "readystack": {
    "rulesDate": "2026-09-28"
  },
  "icon": "icon.png"
}
