  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8195B0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "comment.block.documentation storage.type",
        "comment keyword.codetag",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#93A6BF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.fn",
        "keyword.other.rust",
        "storage.type.function",
        "storage.type.class",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#F2A86E"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#A9B8CC"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#A9B8CC"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw.string"
      ],
      "settings": {
        "foreground": "#D9D27C"
      }
    },
    {
      "name": "Escape / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#8FE0C0"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#F2A86E"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other",
        "support.constant",
        "constant.other.caps",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#7ED6E6"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "storage.type.primitive",
        "storage.type.numeric.go",
        "storage.type.string.go",
        "storage.type.boolean.go",
        "support.type.primitive",
        "entity.name.namespace",
        "entity.name.type.module",
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#B9A6F2"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.function.macro",
        "support.function.builtin",
        "entity.name.function.decorator",
        "meta.function-call.generic",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#9CC2FF"
      }
    },
    {
      "name": "Decorator / attribute",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "meta.attribute.rust",
        "storage.type.annotation",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#E8AEE0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#E8AEE0"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#E4ECF5"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "entity.other.attribute-name.class.css",
        "meta.field.declaration",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#CBD6E4"
      }
    },
    {
      "name": "JSON / YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#F2A86E"
      }
    },
    {
      "name": "Lifetime / label",
      "scope": [
        "entity.name.type.lifetime",
        "storage.modifier.lifetime",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#E8AEE0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#F2A86E"
      }
    },
    {
      "name": "HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B9A6F2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#9CC2FF"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "meta.property-value",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#7ED6E6"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#F2A86E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#E4ECF5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#E4ECF5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#9CC2FF"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#D9D27C"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8195B0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#7ED6E6"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#9CD68A"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#F28A8A"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#E8C66A"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F28A8A",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E8C66A",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#B9A6F2",
    "class": "#B9A6F2",
    "enum": "#B9A6F2",
    "interface": "#B9A6F2",
    "struct": "#B9A6F2",
    "typeParameter": {
      "foreground": "#B9A6F2",
      "italic": true
    },
    "type": "#B9A6F2",
    "parameter": "#E8AEE0",
    "variable": "#E4ECF5",
    "variable.readonly": "#7ED6E6",
    "variable.defaultLibrary": "#7ED6E6",
    "property": "#CBD6E4",
    "property.readonly": "#CBD6E4",
    "enumMember": "#7ED6E6",
    "function": "#9CC2FF",
    "method": "#9CC2FF",
    "macro": "#9CC2FF",
    "function.defaultLibrary": "#9CC2FF",
    "keyword": "#F2A86E",
    "string": "#D9D27C",
    "number": "#7ED6E6",
    "regexp": "#8FE0C0",
    "operator": "#A9B8CC",
    "decorator": {
      "foreground": "#E8AEE0",
      "italic": true
    },
    "label": "#E8AEE0",
    "selfKeyword": "#F2A86E",
    "lifetime": {
      "foreground": "#E8AEE0",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}