  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#A8937E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "comment.block.documentation storage.type",
        "comment keyword.codetag",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#B8A592",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.fn",
        "keyword.other.rust",
        "storage.type.function",
        "storage.type.class",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#F0AE7E"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#BFAE9C"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#BFAE9C"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw.string"
      ],
      "settings": {
        "foreground": "#D6CF86"
      }
    },
    {
      "name": "Escape / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#96D8B8"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#F0AE7E"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other",
        "support.constant",
        "constant.other.caps",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#86D2DE"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "storage.type.primitive",
        "storage.type.numeric.go",
        "storage.type.string.go",
        "storage.type.boolean.go",
        "support.type.primitive",
        "entity.name.namespace",
        "entity.name.type.module",
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#C4ADEE"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.function.macro",
        "support.function.builtin",
        "entity.name.function.decorator",
        "meta.function-call.generic",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#9DBDF5"
      }
    },
    {
      "name": "Decorator / attribute",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "meta.attribute.rust",
        "storage.type.annotation",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#E2AED8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#E2AED8"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#EFE3D3"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "entity.other.attribute-name.class.css",
        "meta.field.declaration",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#DCCDBA"
      }
    },
    {
      "name": "JSON / YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#F0AE7E"
      }
    },
    {
      "name": "Lifetime / label",
      "scope": [
        "entity.name.type.lifetime",
        "storage.modifier.lifetime",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#E2AED8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#F0AE7E"
      }
    },
    {
      "name": "HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C4ADEE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#9DBDF5"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "meta.property-value",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#86D2DE"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#F0AE7E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#EFE3D3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#EFE3D3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#9DBDF5"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#D6CF86"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#A8937E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#86D2DE"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#A6D190"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#F0907E"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#E6C46E"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F0907E",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E6C46E",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#C4ADEE",
    "class": "#C4ADEE",
    "enum": "#C4ADEE",
    "interface": "#C4ADEE",
    "struct": "#C4ADEE",
    "typeParameter": {
      "foreground": "#C4ADEE",
      "italic": true
    },
    "type": "#C4ADEE",
    "parameter": "#E2AED8",
    "variable": "#EFE3D3",
    "variable.readonly": "#86D2DE",
    "variable.defaultLibrary": "#86D2DE",
    "property": "#DCCDBA",
    "property.readonly": "#DCCDBA",
    "enumMember": "#86D2DE",
    "function": "#9DBDF5",
    "method": "#9DBDF5",
    "macro": "#9DBDF5",
    "function.defaultLibrary": "#9DBDF5",
    "keyword": "#F0AE7E",
    "string": "#D6CF86",
    "number": "#86D2DE",
    "regexp": "#96D8B8",
    "operator": "#BFAE9C",
    "decorator": {
      "foreground": "#E2AED8",
      "italic": true
    },
    "label": "#E2AED8",
    "selfKeyword": "#F0AE7E",
    "lifetime": {
      "foreground": "#E2AED8",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}