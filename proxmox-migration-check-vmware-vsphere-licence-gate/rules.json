 {"id":"tf-provider-block","area":"terraform","sev":"high","re":"^\\s*provider\\s+\"vsphere\"","msg":"provider \"vsphere\" block logs in to vCenter.","fix":"provider \"proxmox\" { endpoint = \"https://pve.example.com:8006/\" }"},
