  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#5A6960",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "comment.block.documentation storage.type",
        "comment keyword.codetag",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#4E5D55",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.fn",
        "keyword.other.rust",
        "storage.type.function",
        "storage.type.class",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#A3361F"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#4F5A54"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#4F5A54"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw.string"
      ],
      "settings": {
        "foreground": "#2B4F9E"
      }
    },
    {
      "name": "Escape / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#9A3555"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#A3361F"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other",
        "support.constant",
        "constant.other.caps",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#2E6E4A"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "storage.type.primitive",
        "storage.type.numeric.go",
        "storage.type.string.go",
        "storage.type.boolean.go",
        "support.type.primitive",
        "entity.name.namespace",
        "entity.name.type.module",
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#7A5C0C"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.function.macro",
        "support.function.builtin",
        "entity.name.function.decorator",
        "meta.function-call.generic",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#0F6669"
      }
    },
    {
      "name": "Decorator / attribute",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "meta.attribute.rust",
        "storage.type.annotation",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#7A3E8A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#7A3E8A"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#1F2A25"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "entity.other.attribute-name.class.css",
        "meta.field.declaration",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#33403A"
      }
    },
    {
      "name": "JSON / YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#A3361F"
      }
    },
    {
      "name": "Lifetime / label",
      "scope": [
        "entity.name.type.lifetime",
        "storage.modifier.lifetime",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#7A3E8A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#A3361F"
      }
    },
    {
      "name": "HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7A5C0C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#0F6669"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "meta.property-value",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#2E6E4A"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#A3361F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#1F2A25",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#1F2A25",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#0F6669"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#2B4F9E"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5A6960",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#2E6E4A"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#2E6E4A"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#B0281C"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#7A5C0C"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#B0281C",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#7A5C0C",
        "fontStyle": "strikethrough"
      }
    }
  ],
