{
  "name": "oracle-jdk-license-gate",
  "displayName": "Oracle JDK License Gate",
  "description": "Moving to Temurin or Corretto? Shows which Java every part of your project pulls (CI, Docker, Gradle, SDKMAN, dev container), flags the Oracle-licensed ones on today's date and gives the free line for each.",
  "version": "1.0.17",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "java",
    "jdk",
    "oracle",
    "license",
    "compliance",
    "docker",
    "graalvm",
    "temurin",
    "ci",
    "corretto",
    "adoptium",
    "zulu",
    "liberica",
    "openjdk",
    "migrate",
    "java version"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "oracleJdkLicenseGate.javaMap",
        "title": "Oracle JDK License Gate: Show the Java map (which Java this project pulls + Temurin lines)",
        "category": "Oracle JDK License Gate"
      },
      {
        "command": "oracleJdkLicenseGate.fixAll",
        "title": "Oracle JDK License Gate: Fix all Oracle JDK lines in this workspace (licence)",
        "category": "Oracle JDK License Gate"
      },
      {
        "command": "oracleJdkLicenseGate.checkFile",
        "title": "Oracle JDK License Gate: Check this file",
        "category": "Oracle JDK License Gate"
      },
      {
        "command": "oracleJdkLicenseGate.checkWorkspace",
        "title": "Oracle JDK License Gate: Sweep workspace and write report (licence)",
        "category": "Oracle JDK License Gate"
      },
      {
        "command": "oracleJdkLicenseGate.enterKey",
        "title": "Oracle JDK License Gate: Enter licence key",
        "category": "Oracle JDK License Gate"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "oracle-jdk-license-gate"
  },
  "homepage": "https://getreadystack.com/tools/oracle-jdk-license-gate",
  "icon": "icon.png",
  "readystack": {
    "rulesDate": "2026-09-30",
    "alertUrl": "https://getreadystack.com/tools/oracle-jdk-license-gate?ref=vsix_alert#yjae"
  }
}
