// sentry.client.config.ts - sample Next.js app moving from Sentry SaaS to GlitchTip
import * as Sentry from "@sentry/nextjs";

Sentry.init({
  dsn: "https://3f2a9c1e7b@o451234.ingest.us.sentry.io/4507712345",
  tracesSampleRate: 1.0,
  autoSessionTracking: true,
  replaysSessionSampleRate: 0.1,
  replaysOnErrorSampleRate: 1.0,
  profilesSampleRate: 1.0,
  integrations: [
    Sentry.replayIntegration(),
    Sentry.browserProfilingIntegration(),
    Sentry.feedbackIntegration({ colorScheme: "system" }),
  ],
});

export async function nightlyInvoiceJob(run: () => Promise<void>) {
  await Sentry.withMonitor("nightly-invoices", run, {
    schedule: { type: "crontab", value: "0 2 * * *" },
  });
}

export function reportUpload(file: Uint8Array) {
  Sentry.getCurrentScope().addAttachment({ filename: "upload.bin", data: file });
  Sentry.metrics.count("upload.failed", 1);
}
