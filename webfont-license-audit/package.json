{
  "name": "webfont-license-audit",
  "displayName": "Webfont License Audit",
  "description": "Audits @font-face CSS for proprietary foundry families, desktop-format binaries, renamed OFL families and remote Google Fonts hotlinks - the questions a webfont licence audit letter asks.",
  "version": "1.0.4",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "font",
    "license",
    "font-face",
    "webfont",
    "css",
    "ofl",
    "gdpr",
    "audit"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "webfontLicense.checkFile",
        "title": "Webfont License Audit: Check this file",
        "category": "Webfont License Audit"
      },
      {
        "command": "webfontLicense.checkWorkspace",
        "title": "Webfont License Audit: Sweep workspace and write report (licence)",
        "category": "Webfont License Audit"
      },
      {
        "command": "webfontLicense.enterKey",
        "title": "Webfont License Audit: Enter licence key",
        "category": "Webfont License Audit"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "webfont-license-audit"
  },
  "homepage": "https://getreadystack.com/tools/webfont-license-audit",
  "readystack": {
    "rulesDate": "2026-09-20"
  }
}
