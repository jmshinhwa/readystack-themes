{
  "name": "gerichtskosten-tabelle-lint",
  "displayName": "Kostentabellen-Lint: GKG & RVG 2025 für Mahn-Software",
  "description": "Findet veraltete GKG- und RVG-Gebührenwerte (Stand 2021) und die alte Mahnbescheid-Mindestgebühr 36 € in Code und Config von Inkasso-, Mahn- und Kanzleisoftware. KostRÄG 2025, gültig seit 1.6.2025.",
  "version": "1.0.4",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "mahnbescheid kosten berechnen",
    "GKG",
    "RVG",
    "Gebührentabelle",
    "KostRÄG 2025",
    "Inkasso",
    "Gerichtskosten",
    "Mahnverfahren"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kostenLint.checkFile",
        "title": "Kostentabellen-Lint: GKG & RVG 2025 für Mahn-Software: Check this file",
        "category": "Kostentabellen-Lint: GKG & RVG 2025 für Mahn-Software"
      },
      {
        "command": "kostenLint.checkWorkspace",
        "title": "Kostentabellen-Lint: GKG & RVG 2025 für Mahn-Software: Sweep workspace and write report (licence)",
        "category": "Kostentabellen-Lint: GKG & RVG 2025 für Mahn-Software"
      },
      {
        "command": "kostenLint.enterKey",
        "title": "Kostentabellen-Lint: GKG & RVG 2025 für Mahn-Software: Enter licence key",
        "category": "Kostentabellen-Lint: GKG & RVG 2025 für Mahn-Software"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "gerichtskosten-tabelle-lint"
  },
  "homepage": "https://getreadystack.com/de/tools/gerichtskosten-tabelle-lint",
  "readystack": {
    "rulesDate": "2026-09-28"
  },
  "icon": "icon.png"
}
