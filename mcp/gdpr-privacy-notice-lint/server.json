{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jmshinhwa/gdpr-privacy-notice-lint",
  "description": "16 rules read your privacy.md the way Articles 13 and 14 read it",
  "repository": {
    "url": "https://github.com/jmshinhwa/readystack-themes",
    "source": "github"
  },
  "version": "1.0.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@readystack/gdpr-privacy-notice-lint",
      "version": "1.0.2",
