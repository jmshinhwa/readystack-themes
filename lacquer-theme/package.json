    "color theme",
    "japanese aesthetic theme",
    "warm dark theme",
    "calm coding theme",
    "aesthetic vscode theme",
    "eye friendly theme",
    "matching terminal and editor colors",
    "lacquer"
  ],
  "galleryBanner": {
    "color": "#1A1312",
