{
  "name": "actions-deprecation-lint-2026",
  "displayName": "GitHub Actions Deprecation Lint",
  "description": "Node 20 is removed from GitHub-hosted runners on 2026-09-23 and ubuntu-22.04 deprecation opens 2026-09-17. This checks a workflow file against 25 dated GitHub shutdowns and names the date each line st",
  "version": "0.1.0",
  "publisher": "ReadyStack",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "github-actions",
    "ci",
    "workflow",
    "deprecation",
    "yaml"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "actions-deprecation-lint-2026.audit_file",
        "title": "Audit this workflow file",
        "category": "GitHub Actions Deprecati"
      },
      {
        "command": "actions-deprecation-lint-2026.audit_selection",
        "title": "Audit the selected lines",
        "category": "GitHub Actions Deprecati"
      },
      {
        "command": "actions-deprecation-lint-2026.show_report",
        "title": "Show the last findings",
        "category": "GitHub Actions Deprecati"
      },
      {
        "command": "actions-deprecation-lint-2026.workspace_scan",
        "title": "Scan every workflow in the repository",
        "category": "GitHub Actions Deprecati"
      },
      {
        "command": "actions-deprecation-lint-2026.export_report",
        "title": "Export the findings to a file",
        "category": "GitHub Actions Deprecati"
      },
      {
        "command": "actions-deprecation-lint-2026.ci_json",
        "title": "Print JSON for CI",
        "category": "GitHub Actions Deprecati"
      },
      {
        "command": "actions-deprecation-lint-2026.watch_on_save",
        "title": "Re-check on save",
        "category": "GitHub Actions Deprecati"
      },
      {
        "command": "actions-deprecation-lint-2026.custom_rules",
        "title": "Add your own rules alongside the 25 built in",
        "category": "GitHub Actions Deprecati"
      }
    ],
    "configuration": {
      "title": "GitHub Actions Deprecation Lint",
      "properties": {
        "actions-deprecation-lint-2026.min_severity": {
          "type": "string",
          "default": "info",
          "description": "Hide findings below this severity (info, warn, error)"
        },
        "actions-deprecation-lint-2026.report_format": {
          "type": "string",
          "default": "csv",
          "description": "Format used when exporting the findings (csv, json, html)"
        },
        "actions-deprecation-lint-2026.max_files": {
          "type": "number",
          "default": 2000,
          "description": "Most files to open during a repository scan"
        },
        "actions-deprecation-lint-2026.exclude_glob": {
          "type": "string",
          "default": "**/node_modules/**",
          "description": "Paths skipped during a repository scan"
        },
        "actions-deprecation-lint-2026.show_on_start": {
          "type": "boolean",
          "default": false,
          "description": "Audit the open file once when the window opens"
        },
        "actions-deprecation-lint-2026.extraRules": {
          "type": "array",
          "default": [],
          "description": "Extra rules of your own, checked alongside the 25 dated GitHub deprecations that ship inside."
        }
      }
    }
  },
  "icon": "icon.png"
}
