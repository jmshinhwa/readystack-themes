{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jmshinhwa/nis2-incident-runbook-lint",
  "description": "Reads your incident-response runbook and says which of the three Article 23 clocks it gets wrong",
  "repository": {
    "url": "https://github.com/jmshinhwa/readystack-themes",
    "source": "github"
  },
  "version": "1.0.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@readystack/nis2-incident-runbook-lint",
      "version": "1.0.3",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp",
          "description": "run as an MCP server (stdio)"
        }
      ]
    }
  ]
}