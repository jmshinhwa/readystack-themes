{
  "name": "umweltaussagen-lint-uwg-2026",
  "displayName": "Green-Claims-Lint: Umweltaussagen nach UWG 2026",
  "description": "Findet in Produkttexten Umweltaussagen, die ab 27.09.2026 nach dem UWG-Anhang (Nr. 2a, 4a, 4b, 4c, 10a) verboten sind: umweltfreundlich, klimaneutral, eigene Siegel – mit Nummer und Fix.",
  "version": "1.0.2",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "greenwashing",
    "uwg",
    "umweltaussagen",
    "klimaneutral",
    "empco",
    "nachhaltigkeit",
    "produkttexte"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "umweltLint.checkFile",
        "title": "Green-Claims-Lint: Umweltaussagen nach UWG 2026: Check this file",
        "category": "Green-Claims-Lint: Umweltaussagen nach UWG 2026"
      },
      {
        "command": "umweltLint.checkWorkspace",
        "title": "Green-Claims-Lint: Umweltaussagen nach UWG 2026: Sweep workspace and write report (licence)",
        "category": "Green-Claims-Lint: Umweltaussagen nach UWG 2026"
      },
      {
        "command": "umweltLint.enterKey",
        "title": "Green-Claims-Lint: Umweltaussagen nach UWG 2026: Enter licence key",
        "category": "Green-Claims-Lint: Umweltaussagen nach UWG 2026"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "umweltaussagen-lint-uwg-2026"
  },
  "homepage": "https://getreadystack.com/de/tools/umweltaussagen-lint-uwg-2026",
  "icon": "icon.png"
}
