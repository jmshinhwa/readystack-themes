{
  "name": "config-dsl-lint-snippet-pack",
  "displayName": "Config & DSL Lint + Snippets — 9 Sets",
  "description": "Your config files are never compiled — nothing fails until deploy. 36 snippets and 28 lint rules for 9 of them, inside the editor, offline.",
  "version": "0.1.0",
  "publisher": "ReadyStack",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Snippets",
    "Programming Languages"
  ],
  "keywords": [
    "microprofile",
    "toml",
    "devicetree",
    "renpy",
    "autohotkey"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "config-dsl-lint-snippet-pack.audit_file",
        "title": "Audit this file",
        "category": "Config & DSL Lint + Snip"
      },
      {
        "command": "config-dsl-lint-snippet-pack.audit_selection",
        "title": "Audit only the selected lines",
        "category": "Config & DSL Lint + Snip"
      },
      {
        "command": "config-dsl-lint-snippet-pack.insert_snippet",
        "title": "Insert a snippet from the pack",
        "category": "Config & DSL Lint + Snip"
      },
      {
        "command": "config-dsl-lint-snippet-pack.workspace_scan",
        "title": "Scan the whole workspace",
        "category": "Config & DSL Lint + Snip"
      },
      {
        "command": "config-dsl-lint-snippet-pack.watch_on_save",
        "title": "Re-check on every save",
        "category": "Config & DSL Lint + Snip"
      },
      {
        "command": "config-dsl-lint-snippet-pack.quick_fix",
        "title": "Apply the suggested fix",
        "category": "Config & DSL Lint + Snip"
      },
      {
        "command": "config-dsl-lint-snippet-pack.export_report",
        "title": "Export the findings as a report",
        "category": "Config & DSL Lint + Snip"
      }
    ],
    "configuration": {
      "title": "Config & DSL Lint + Snippets — 9 Sets",
      "properties": {
        "config-dsl-lint-snippet-pack.report_format": {
          "type": "string",
          "default": "csv",
          "description": "Default export format for the report"
        },
        "config-dsl-lint-snippet-pack.max_files": {
          "type": "number",
          "default": 400,
          "description": "Most files a workspace scan will open"
        },
        "config-dsl-lint-snippet-pack.exclude_glob": {
          "type": "string",
          "default": "**/{node_modules,dist,build,out,target,.venv,coverage}/**",
          "description": "Paths the workspace scan skips"
        },
        "config-dsl-lint-snippet-pack.show_on_start": {
          "type": "boolean",
          "default": false,
          "description": "Check the open file once when the editor starts"
        },
        "config-dsl-lint-snippet-pack.extraRules": {
          "type": "array",
          "default": [],
          "description": "Extra rules of your own, checked alongside the 28 that ship inside."
        }
      }
    },
    "snippets": [
      {
        "language": "ahk",
        "path": "./snippets/ahk-ahk2-autohotkey.code-snippets"
      },
      {
        "language": "ahk2",
        "path": "./snippets/ahk-ahk2-autohotkey.code-snippets"
      },
      {
        "language": "autohotkey",
        "path": "./snippets/ahk-ahk2-autohotkey.code-snippets"
      },
      {
        "language": "dts",
        "path": "./snippets/dts-devicetree.code-snippets"
      },
      {
        "language": "devicetree",
        "path": "./snippets/dts-devicetree.code-snippets"
      },
      {
        "language": "inkling",
        "path": "./snippets/inkling.code-snippets"
      },
      {
        "language": "javascript",
        "path": "./snippets/javascript-typescript.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/javascript-typescript.code-snippets"
      },
      {
        "language": "jsonc",
        "path": "./snippets/jsonc-json.code-snippets"
      },
      {
        "language": "json",
        "path": "./snippets/jsonc-json.code-snippets"
      },
      {
        "language": "properties",
        "path": "./snippets/properties-ini.code-snippets"
      },
      {
        "language": "ini",
        "path": "./snippets/properties-ini.code-snippets"
      },
      {
        "language": "renpy",
        "path": "./snippets/renpy.code-snippets"
      },
      {
        "language": "swift",
        "path": "./snippets/swift.code-snippets"
      },
      {
        "language": "toml",
        "path": "./snippets/toml.code-snippets"
      }
    ]
  },
  "icon": "icon.png"
}
