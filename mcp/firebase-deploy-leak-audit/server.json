{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jmshinhwa/firebase-deploy-leak-audit",
  "description": "Reads firebase.json and names the files your next firebase deploy would publish to the open web",
  "repository": {
    "url": "https://github.com/jmshinhwa/readystack-themes",
    "source": "github"
  },
  "version": "1.0.5",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@readystack/firebase-deploy-leak-audit",
      "version": "1.0.5",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp",
          "description": "run as an MCP server (stdio)"
        }
      ]
    }
  ]
}