{
  "name": "gpsr-listing-lint",
  "displayName": "GPSR Listing Lint",
  "description": "Audits product feed files (CSV/TSV/XML) against GPSR Article 19: manufacturer address, EU Responsible Person, product picture and identifier, warnings. 12 rules, offline.",
  "version": "1.0.1",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "gpsr",
    "product feed",
    "ecommerce",
    "compliance",
    "csv",
    "eu",
    "marketplace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gpsrListingLint.checkFile",
        "title": "GPSR Listing Lint — EU Product Feed Audit: Check this file",
        "category": "GPSR Listing Lint — EU Product Feed Audit"
      },
      {
        "command": "gpsrListingLint.checkWorkspace",
        "title": "GPSR Listing Lint — EU Product Feed Audit: Sweep workspace and write report (licence)",
        "category": "GPSR Listing Lint — EU Product Feed Audit"
      },
      {
        "command": "gpsrListingLint.enterKey",
        "title": "GPSR Listing Lint — EU Product Feed Audit: Enter licence key",
        "category": "GPSR Listing Lint — EU Product Feed Audit"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "gpsr-listing-lint"
  },
  "homepage": "https://getreadystack.com/tools/gpsr-listing-lint",
  "icon": "icon.png"
}
