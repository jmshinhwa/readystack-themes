# main.tf — sessions, rate limits, jobs and page cache on AWS ElastiCache
resource "aws_elasticache_parameter_group" "sessions" {
  name   = "sessions-params"
  family = "redis5.0"
}

resource "aws_elasticache_replication_group" "sessions" {
  replication_group_id = "sessions"
  description          = "user sessions"
  engine               = "redis"
  engine_version       = "5.0.6"
  node_type            = "cache.m5.large"
  num_cache_clusters   = 2
  parameter_group_name = aws_elasticache_parameter_group.sessions.name
}

resource "aws_elasticache_cluster" "rate_limit" {
  cluster_id      = "rate-limit"
  engine          = "redis"
  engine_version  = "4.0.10"
  node_type       = "cache.t3.small"
  num_cache_nodes = 1
}

resource "aws_elasticache_cluster" "jobs" {
  cluster_id      = "jobs"
  engine          = "redis"
  engine_version  = "6.2"
  node_type       = "cache.r6g.large"
  num_cache_nodes = 1
}

resource "aws_elasticache_serverless_cache" "pages" {
  name   = "pages"
  engine = "redis"
}

resource "aws_ecs_task_definition" "worker" {
  family = "worker"
  container_definitions = jsonencode([{
    name  = "sidecar-cache"
    image = "redis:7.4-alpine"
  }])
}
