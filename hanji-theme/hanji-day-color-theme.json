  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#76695A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "comment.block.documentation storage.type",
        "comment keyword.codetag",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#6E6355",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.fn",
        "keyword.other.rust",
        "storage.type.function",
        "storage.type.class",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#34548C"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#5C5247"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#5C5247"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw.string"
      ],
      "settings": {
        "foreground": "#4A6B2E"
      }
    },
    {
      "name": "Escape / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#2D725C"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#34548C"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other",
        "support.constant",
        "constant.other.caps",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#A23B32"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "storage.type.primitive",
        "storage.type.numeric.go",
        "storage.type.string.go",
        "storage.type.boolean.go",
        "support.type.primitive",
        "entity.name.namespace",
        "entity.name.type.module",
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#86600F"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.function.macro",
        "support.function.builtin",
        "entity.name.function.decorator",
        "meta.function-call.generic",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#1F6A6E"
      }
    },
    {
      "name": "Decorator / attribute",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "meta.attribute.rust",
        "storage.type.annotation",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#6E4A80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#6E4A80"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#2E2923"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "entity.other.attribute-name.class.css",
        "meta.field.declaration",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#4F4437"
      }
    },
    {
      "name": "JSON / YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#34548C"
      }
    },
    {
      "name": "Lifetime / label",
      "scope": [
        "entity.name.type.lifetime",
        "storage.modifier.lifetime",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#6E4A80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#34548C"
      }
    },
    {
      "name": "HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#86600F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#1F6A6E"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "meta.property-value",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#A23B32"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#34548C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#2E2923",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#2E2923",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#1F6A6E"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#4A6B2E"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#76695A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#A23B32"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#4A6B2E"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#A23B32"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#86600F"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#A23B32",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#86600F",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#86600F",
    "class": "#86600F",
    "enum": "#86600F",
    "interface": "#86600F",
    "struct": "#86600F",
    "typeParameter": {
      "foreground": "#86600F",
      "italic": true
    },
    "type": "#86600F",
    "parameter": "#6E4A80",
    "variable": "#2E2923",
    "variable.readonly": "#A23B32",
    "variable.defaultLibrary": "#A23B32",
    "property": "#4F4437",
    "property.readonly": "#4F4437",
    "enumMember": "#A23B32",
    "function": "#1F6A6E",
    "method": "#1F6A6E",
    "macro": "#1F6A6E",
    "function.defaultLibrary": "#1F6A6E",
    "keyword": "#34548C",
    "string": "#4A6B2E",
    "number": "#A23B32",
    "regexp": "#2D725C",
    "operator": "#5C5247",
    "decorator": {
      "foreground": "#6E4A80",
      "italic": true
    },
    "label": "#6E4A80",
    "selfKeyword": "#34548C",
    "lifetime": {
      "foreground": "#6E4A80",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}