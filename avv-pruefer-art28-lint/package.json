{
  "name": "avv-pruefer-art28-lint",
  "displayName": "AVV-Prüfer – Auftragsverarbeitungsvertrag Lint",
  "description": "Prüft Auftragsverarbeitungsverträge (AVV/DPA in Markdown) auf die Pflichtinhalte nach Art. 28 Abs. 3 DSGVO, Privacy Shield, alte SCC 2010/87/EU, § 11 BDSG a. F. und 72-Stunden-Meldefristen.",
  "version": "1.0.1",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "auftragsverarbeitungsvertrag",
    "avv",
    "dsgvo",
    "art. 28",
    "dpa",
    "datenschutz",
    "auftragsverarbeitung",
    "markdown lint"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "avvPruefer.checkFile",
        "title": "AVV-Prüfer – Auftragsverarbeitungsvertrag Lint: Check this file",
        "category": "AVV-Prüfer – Auftragsverarbeitungsvertrag Lint"
      },
      {
        "command": "avvPruefer.checkWorkspace",
        "title": "AVV-Prüfer – Auftragsverarbeitungsvertrag Lint: Sweep workspace and write report (licence)",
        "category": "AVV-Prüfer – Auftragsverarbeitungsvertrag Lint"
      },
      {
        "command": "avvPruefer.enterKey",
        "title": "AVV-Prüfer – Auftragsverarbeitungsvertrag Lint: Enter licence key",
        "category": "AVV-Prüfer – Auftragsverarbeitungsvertrag Lint"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "avv-pruefer-art28-lint"
  },
  "homepage": "https://getreadystack.com/de/tools/avv-pruefer-art28-lint",
  "readystack": {
    "rulesDate": "2026-09-27"
  },
  "icon": "icon.png"
}
