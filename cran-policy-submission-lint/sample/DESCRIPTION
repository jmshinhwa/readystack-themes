#### FILE: NAMESPACE ####
exportPattern("^[[:alpha:]]+")
importFrom(stats,weighted.mean)

#### FILE: R/weights.R ####
library(dplyr)

#' Rescale survey weights
#'
#' @examples
#' \dontrun{
#' rescale_weights(x)
#' }
#' @export
rescale_weights <- function(x, normalise = T) {
  if (!requireNamespace("ggplot2", quietly = TRUE)) install.packages("ggplot2")
  setwd("/tmp/survey")
  options(stringsAsFactors = FALSE)
  par(mfrow = c(1, 2))
  set.seed(42)
  ip <- installed.packages()
  w <- dplyr:::check_weights(x)
  cat("rescaling", length(x), "weights\n")
  write.csv(w, "~/survey-weights.csv")
  assign("last_weights", w, envir = .GlobalEnv)
  cached <<- w
  source("helpers.R")
  print(w)
  w  # naive fallback for the naïve case
}
