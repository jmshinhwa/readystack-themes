{
  "name": "cms-0057-api-gate",
  "displayName": "CMS-0057 API Gate",
  "description": "Audit a FHIR CapabilityStatement against the CMS-0057-F prior authorization rule before the 1 January 2027 compliance date, without leaving the editor.",
  "version": "1.0.0",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "fhir",
    "cms-0057",
    "prior authorization",
    "capabilitystatement",
    "interoperability",
    "payer",
    "hl7",
    "us core"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cms0057Gate.checkFile",
        "title": "CMS-0057 API Gate - FHIR CapabilityStatement: Check this file",
        "category": "CMS-0057 API Gate - FHIR CapabilityStatement"
      },
      {
        "command": "cms0057Gate.checkWorkspace",
        "title": "CMS-0057 API Gate - FHIR CapabilityStatement: Sweep workspace and write report (licence)",
        "category": "CMS-0057 API Gate - FHIR CapabilityStatement"
      },
      {
        "command": "cms0057Gate.enterKey",
        "title": "CMS-0057 API Gate - FHIR CapabilityStatement: Enter licence key",
        "category": "CMS-0057 API Gate - FHIR CapabilityStatement"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "cms-0057-api-gate"
  },
  "homepage": "https://getreadystack.com/tools/cms-0057-api-gate",
  "icon": "icon.png"
}
