[
  {"id": "spf_lookup_limit", "sev": "error", "msg": "SPF record needs {n} DNS lookups — the limit is 10 (RFC 7208 4.6.4). Receivers return PermError and treat the domain as having no SPF at all. Flatten or remove includes.", "ref": "RFC 7208 4.6.4"},
  {"id": "spf_lookup_near", "sev": "warning", "msg": "SPF record already spends {n} of the 10 permitted DNS lookups in the record itself; every include: resolves to a record that can spend more. Count the nested ones before you publish.", "ref": "RFC 7208 4.6.4"},
  {"id": "spf_pass_all", "sev": "error", "msg": "'+all' (or a bare 'all') passes SPF for every sender on the internet, which is the same as publishing no SPF. End the record with '-all', or '~all' while you migrate.", "ref": "RFC 7208 5.1"},
  {"id": "spf_ptr", "sev": "error", "msg": "The 'ptr' mechanism is deprecated and must not be published — RFC 7208 5.5 says receivers may ignore it, and it costs a DNS lookup per candidate host. Replace it with ip4:/ip6: or include:.", "ref": "RFC 7208 5.5"},
  {"id": "spf_no_all", "sev": "warning", "msg": "SPF record has no 'all' mechanism and no 'redirect=' modifier, so everything it does not list gets Neutral — the same result as no policy. Add '-all' or '~all' at the end.", "ref": "RFC 7208 4.7"},
  {"id": "spf_duplicate", "sev": "error", "msg": "Second 'v=spf1' record published on the same name. More than one SPF record for a domain is a PermError (RFC 7208 4.5) — merge them into one record.", "ref": "RFC 7208 4.5"},
  {"id": "spf_string_255", "sev": "error", "msg": "A single quoted TXT string is {n} characters; the DNS wire format caps one character-string at 255. Split it into several quoted strings on the same record — they are concatenated with no separator.", "ref": "RFC 1035 3.3.14"},
  {"id": "dmarc_missing_p", "sev": "error", "msg": "DMARC record has no 'p=' tag. A record without a policy tag is discarded by receivers, so the domain is treated as having no DMARC record — which also fails the bulk-sender requirements at Gmail and Yahoo.", "ref": "RFC 7489 6.3"},
  {"id": "dmarc_p_none", "sev": "warning", "msg": "'p=none' only asks for reports; receivers still deliver mail that fails alignment, so nothing is blocked. It satisfies 'a DMARC record exists' and nothing else — move to quarantine, then reject.", "ref": "RFC 7489 6.3"},
  {"id": "dmarc_no_rua", "sev": "warning", "msg": "No 'rua=' tag, so no aggregate reports are ever sent and you are blind to which of your senders fail alignment. Add rua=mailto: before you tighten the policy.", "ref": "RFC 7489 7.2"},
  {"id": "dmarc_owner", "sev": "error", "msg": "A DMARC record is only read at the name '_dmarc.<domain>'. This record is published somewhere else, so no receiver will ever look it up.", "ref": "RFC 7489 6.1"},
  {"id": "dmarc_sp_none", "sev": "error", "msg": "'sp=none' overrides the policy for every subdomain, so mail from a subdomain nobody uses is unprotected while the parent domain is enforced. Drop 'sp=' to inherit, or set sp=reject.", "ref": "RFC 7489 6.3"},
  {"id": "dkim_p_empty", "sev": "error", "msg": "Empty 'p=' in a DKIM record means the key is revoked — every signature made with this selector fails, and mail signed only by it loses DKIM. Publish the public key or delete the selector.", "ref": "RFC 6376 3.6.1"},
  {"id": "dkim_key_short", "sev": "warning", "msg": "The 'p=' key blob is {n} base64 characters, which is about a 1024-bit RSA key or smaller. RFC 8301 requires signers to use at least 1024 bits and recommends 2048 — rotate the selector.", "ref": "RFC 8301 3.2"},
  {"id": "dkim_test_mode", "sev": "warning", "msg": "'t=y' puts the selector in test mode, which tells receivers to treat a failed signature as if the message were unsigned. Remove it once the selector is live.", "ref": "RFC 6376 3.6.1"}
]
