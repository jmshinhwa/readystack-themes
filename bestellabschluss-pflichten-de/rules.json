[
 {
  "id": "bestellbutton_wording",
  "sev": "error",
  "mode": "forbid",
  "re": "(?:<(?:button|a)\\b[^>]*>\\s*|value=\"\\s*)(?:jetzt bestellen|bestellung abschicken|bestellung absenden|bestellen|absenden|weiter|anmelden|submit|senden|order now)\\s*(?:<|\")",
  "msg": "Der Bestellbutton ist nicht eindeutig beschriftet; zulässig ist nur \"Zahlungspflichtig bestellen\" oder eine ebenso eindeutige Formulierung",
  "law": "§ 312j Abs. 3 BGB",
  "since": "2012-08-01"
 },
 {
  "id": "bestellbutton_fehlt",
  "sev": "error",
  "mode": "require",
  "re": "zahlungspflichtig bestellen|kostenpflichtig bestellen|zahlungspflichtigen vertrag|jetzt kaufen",
  "msg": "Keine eindeutige Bestellbutton-Beschriftung in der Datei; ohne sie kommt der Vertrag nach § 312j Abs. 4 BGB nicht zustande",
  "law": "§ 312j Abs. 3 BGB",
  "since": "2012-08-01"
 },
 {
  "id": "gesamtpreis_fehlt",
  "sev": "error",
  "mode": "require",
  "re": "gesamt(?:preis|summe|betrag)|summe gesamt|zu zahlender betrag",
  "msg": "Der Gesamtpreis steht nicht unmittelbar vor dem Bestellbutton",
