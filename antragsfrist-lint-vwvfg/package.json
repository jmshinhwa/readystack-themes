{
  "name": "antragsfrist-lint-vwvfg",
  "displayName": "Antragsfrist-Lint: Förderfristen (§ 31 VwVfG)",
  "description": "Prüft Förderprogramm-Seiten (Markdown): abgelaufene Antragsfristen, fehlende Jahreszahl, Fristende an Samstag/Sonntag/Feiertag nach § 31 Abs. 3 VwVfG und fehlender Zugangs-Hinweis.",
  "version": "1.0.3",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "antragsfrist",
    "vwvfg",
    "foerderprogramm",
    "frist",
    "markdown",
    "deutschland",
    "kommune"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "antragsfristLint.checkFile",
        "title": "Antragsfrist-Lint: Förderfristen (§ 31 VwVfG): Check this file",
        "category": "Antragsfrist-Lint: Förderfristen (§ 31 VwVfG)"
      },
      {
        "command": "antragsfristLint.checkWorkspace",
        "title": "Antragsfrist-Lint: Förderfristen (§ 31 VwVfG): Sweep workspace and write report (licence)",
        "category": "Antragsfrist-Lint: Förderfristen (§ 31 VwVfG)"
      },
      {
        "command": "antragsfristLint.enterKey",
        "title": "Antragsfrist-Lint: Förderfristen (§ 31 VwVfG): Enter licence key",
        "category": "Antragsfrist-Lint: Förderfristen (§ 31 VwVfG)"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "antragsfrist-lint-vwvfg"
  },
  "homepage": "https://getreadystack.com/de/tools/antragsfrist-lint-vwvfg",
  "icon": "icon.png"
}
