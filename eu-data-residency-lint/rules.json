  "version": "2026.09",
  "note": "Zones: eea = EU27 + Iceland/Liechtenstein/Norway. adequacy = covered by a European Commission adequacy decision. third = no adequacy decision; needs SCCs/BCRs plus a transfer impact assessment. us = adequacy only for organisations self-certified under the EU-US Data Privacy Framework.",
  "zones": {
    "eea": "Inside the EEA — no Chapter V transfer.",
    "adequacy": "Outside the EEA but covered by an adequacy decision — lawful, but the decision must be named in your Article 30 record.",
    "us": "United States — lawful only where the receiving organisation is self-certified under the EU-US Data Privacy Framework.",
    "third": "Third country with no adequacy decision — needs SCCs or BCRs plus a transfer impact assessment (Articles 46-49)."
  },
