{
  "name": "barrierefreiheitserklaerung-check",
  "displayName": "Barrierefreiheitserklärung Check (BFSG, BITV)",
  "description": "Prüft Ihre Erklärung zur Barrierefreiheit (Markdown/HTML) auf die Pflichtangaben nach BFSG Anlage 3 und BITV 2.0 § 7 / § 12b BGG – mit Zeilennummer und Korrekturvorschlag.",
  "version": "1.0.0",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "barrierefreiheit",
    "bfsg",
    "bitv",
    "barrierefreiheitserklärung",
    "wcag",
    "accessibility",
    "eaa"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bfErklaerung.checkFile",
        "title": "Barrierefreiheitserklärung Check (BFSG, BITV): Check this file",
        "category": "Barrierefreiheitserklärung Check (BFSG, BITV)"
      },
      {
        "command": "bfErklaerung.checkWorkspace",
        "title": "Barrierefreiheitserklärung Check (BFSG, BITV): Sweep workspace and write report (licence)",
        "category": "Barrierefreiheitserklärung Check (BFSG, BITV)"
      },
      {
        "command": "bfErklaerung.enterKey",
        "title": "Barrierefreiheitserklärung Check (BFSG, BITV): Enter licence key",
        "category": "Barrierefreiheitserklärung Check (BFSG, BITV)"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "barrierefreiheitserklaerung-check"
  },
  "homepage": "https://getreadystack.com/tools/barrierefreiheitserklaerung-check",
  "icon": "icon.png"
}
