{
  "name": "jct-transition-lint-2026",
  "displayName": "インボイス経過措置リンター 2026（80%→70%）",
  "description": "2026年9月30日で80%控除が終わります。10月1日からは50%ではなく70%です（令和8年度税制改正）。請求・仕入コードに残った 0.8 と 0.5、明細ごとの端数処理、T+13桁でない登録番号を、行番号と修正案つきで指摘します。",
  "version": "0.1.2",
  "publisher": "ReadyStack",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "invoice",
    "japan",
    "tax",
    "lint",
    "jct"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jct-transition-lint-2026.audit_file",
        "title": "このファイルを検査",
        "category": "JCT 経過措置リンター 2026"
      },
      {
        "command": "jct-transition-lint-2026.audit_selection",
        "title": "選択範囲だけ検査",
        "category": "JCT 経過措置リンター 2026"
      },
      {
        "command": "jct-transition-lint-2026.show_report",
        "title": "結果パネルを開く",
        "category": "JCT 経過措置リンター 2026"
      },
      {
        "command": "jct-transition-lint-2026.workspace_scan",
        "title": "ワークスペース全体を走査",
        "category": "JCT 経過措置リンター 2026"
      },
      {
        "command": "jct-transition-lint-2026.export_report",
        "title": "結果を書き出す（CSV/JSON/HTML）",
        "category": "JCT 経過措置リンター 2026"
      },
      {
        "command": "jct-transition-lint-2026.watch_on_save",
        "title": "保存時に自動で再検査",
        "category": "JCT 経過措置リンター 2026"
      },
      {
        "command": "jct-transition-lint-2026.ci_json",
        "title": "CI 用 JSON 出力",
        "category": "JCT 経過措置リンター 2026"
      }
    ],
    "configuration": {
      "title": "JCT 経過措置リンター 2026",
      "properties": {
        "jct-transition-lint-2026.min_severity": {
          "type": "string",
          "default": "info",
          "description": "この深刻度未満は表示しない（info|warn|error）"
        },
        "jct-transition-lint-2026.report_format": {
          "type": "string",
          "default": "csv",
          "description": "書き出しの既定形式（csv|json|html）"
        },
        "jct-transition-lint-2026.max_files": {
          "type": "number",
          "default": 2000,
          "description": "ワークスペース走査時の最大ファイル数"
        },
        "jct-transition-lint-2026.exclude_glob": {
          "type": "string",
          "default": "**/node_modules/**",
          "description": "走査から除外するパス（glob）"
        },
        "jct-transition-lint-2026.extraRules": {
          "type": "array",
          "default": [],
          "description": "社内ルールの追加（既定の24規則と一緒に検査します）"
        }
      }
    }
  },
  "icon": "icon.png"
}