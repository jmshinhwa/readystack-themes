// firestore.rules — drafted by a coding assistant, shipped unchanged
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 8, 20);
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /config/public {
      allow read, write: if true;
    }

    match /admin/{docId} {
      allow read, write: if request.auth.uid == 'Yk3QpZ7mTnUaB2cE';
    }
  }
}
