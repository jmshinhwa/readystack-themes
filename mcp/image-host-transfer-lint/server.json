{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jmshinhwa/image-host-transfer-lint",
  "description": "Names every image, font, badge and embed in your docs that sends an EU reader's IP outside the EEA",
  "repository": {
    "url": "https://github.com/jmshinhwa/readystack-themes",
    "source": "github"
  },
  "version": "1.0.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@readystack/image-host-transfer-lint",
      "version": "1.0.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp",
          "description": "run as an MCP server (stdio)"
        }
      ]
    }
  ]
}