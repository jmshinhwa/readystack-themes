[
 {
  "id": "trunk-source-cdn",
  "kind": "source",
  "sev": "error",
  "match": "cdn\\.cocoapods\\.org",
  "msg": "source points at the CocoaPods trunk CDN; every pod below resolves from trunk, which accepts no new pod or version from 2026-12-02."
 },
 {
  "id": "trunk-source-git",
  "kind": "source",
  "sev": "error",
  "match": "github\\.com/CocoaPods/Specs",
  "msg": "source points at the CocoaPods/Specs git repo (trunk); it is archived read-only from 2026-12-02."
 },
 {
  "id": "trunk-source-implicit",
  "kind": "implicit",
  "sev": "error",
  "msg": "no source line, so CocoaPods resolves every pod from trunk (cdn.cocoapods.org) by default; trunk accepts no new pod or version from 2026-12-02."
 },
 {
  "id": "podspec-trunk-push",
  "kind": "podspec",
  "sev": "error",
  "msg": "this podspec is released with pod trunk push, which trunk refuses from 2026-12-02. Ship a Package.swift at the repo root and tag the same version so users can add it with Swift Package Manager."
 },
 {
  "id": "podspec-prepare-command",
  "kind": "prepare",
  "sev": "error",
  "msg": "prepare_command: trunk has refused new pods that use it since May 2025, and Swift Package Manager has no equivalent. Move the script into a build tool plugin or ship a prebuilt XCFramework as a .binaryTarget."
 },
