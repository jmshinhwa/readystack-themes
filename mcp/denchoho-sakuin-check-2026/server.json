  },
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@readystack/denchoho-sakuin-check-2026",
      "version": "1.0.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp",
          "description": "run as an MCP server (stdio)"
