{
  "name": "wordpress-privacy-lint",
  "displayName": "WordPress Privacy Lint (GDPR / DSGVO)",
  "description": "Lints WordPress plugin PHP for the 12 privacy duties the plugin author owns: missing Art. 15/17 exporter and eraser hooks, raw IPs, Google Fonts, phone-home and pre-consent cookies.",
  "version": "1.0.0",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "wordpress",
    "gdpr",
    "dsgvo",
    "privacy",
    "php",
    "plugin-review",
    "lint",
    "datenschutz"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wpPrivacyLint.checkFile",
        "title": "WordPress Privacy Lint (GDPR / DSGVO): Check this file",
        "category": "WordPress Privacy Lint (GDPR / DSGVO)"
      },
      {
        "command": "wpPrivacyLint.checkWorkspace",
        "title": "WordPress Privacy Lint (GDPR / DSGVO): Sweep workspace and write report (licence)",
        "category": "WordPress Privacy Lint (GDPR / DSGVO)"
      },
      {
        "command": "wpPrivacyLint.enterKey",
        "title": "WordPress Privacy Lint (GDPR / DSGVO): Enter licence key",
        "category": "WordPress Privacy Lint (GDPR / DSGVO)"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa-ai/readystack"
  },
  "homepage": "https://getreadystack.com/tools/wordpress-privacy-lint",
  "icon": "icon.png"
}
