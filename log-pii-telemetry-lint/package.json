{
  "name": "log-pii-telemetry-lint",
  "displayName": "PII-in-Logs Lint (console.log(req.body))",
  "description": "Names every line where your Node/TypeScript service writes personal data into logs, crash reports and analytics: console.log(req.body), pino without redact, sendDefaultPii: true. 22 rules.",
  "version": "1.0.0",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "gdpr",
    "pii",
    "logging",
    "privacy",
    "sentry",
    "pino",
    "typescript",
    "observability",
    "data-minimisation"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "piiLogLint.checkFile",
        "title": "PII-in-Logs Lint (console.log(req.body)): Check this file",
        "category": "PII-in-Logs Lint (console.log(req.body))"
      },
      {
        "command": "piiLogLint.checkWorkspace",
        "title": "PII-in-Logs Lint (console.log(req.body)): Sweep workspace and write report (licence)",
        "category": "PII-in-Logs Lint (console.log(req.body))"
      },
      {
        "command": "piiLogLint.enterKey",
        "title": "PII-in-Logs Lint (console.log(req.body)): Enter licence key",
        "category": "PII-in-Logs Lint (console.log(req.body))"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa-ai/readystack"
  },
  "homepage": "https://getreadystack.com/tools/log-pii-telemetry-lint",
  "icon": "icon.png"
}
