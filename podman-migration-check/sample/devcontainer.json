# compose.yaml — a team stack written on Docker Desktop
services:
  web:
    image: nginx:1.27
    ports:
      - "80:8080"
    environment:
      API_URL: http://host.docker.internal:3000
  agent:
    image: docker.io/portainer/agent:2.21.4
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
  kubectl:
    image: docker.io/bitnami/kubectl:1.31
    environment:
      KUBE_API: https://kubernetes.docker.internal:6443
    command: ["config", "use-context", "docker-desktop"]
