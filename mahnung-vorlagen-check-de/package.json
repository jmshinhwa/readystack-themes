{
  "name": "mahnung-vorlagen-check-de",
  "displayName": "Mahnung Vorlagen Check – BGB 288, ZPO 692",
  "description": "Prüft Mahnungs-Vorlagen (.md/.txt/.html/.twig) auf falsche Widerspruchs- und Einspruchsfristen, Verzugszinsen und 40-Euro-Pauschale je Kundentyp und nahende Verjährung – 14 Regeln, mit Zeile.",
  "version": "1.0.2",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "mahnung",
    "mahnbescheid",
    "widerspruch",
    "verzugszinsen",
    "verjährung",
    "mahnwesen",
    "inkasso"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mahnCheck.checkFile",
        "title": "Mahnung Vorlagen Check – BGB 288, ZPO 692: Check this file",
        "category": "Mahnung Vorlagen Check – BGB 288, ZPO 692"
      },
      {
        "command": "mahnCheck.checkWorkspace",
        "title": "Mahnung Vorlagen Check – BGB 288, ZPO 692: Sweep workspace and write report (licence)",
        "category": "Mahnung Vorlagen Check – BGB 288, ZPO 692"
      },
      {
        "command": "mahnCheck.enterKey",
        "title": "Mahnung Vorlagen Check – BGB 288, ZPO 692: Enter licence key",
        "category": "Mahnung Vorlagen Check – BGB 288, ZPO 692"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
