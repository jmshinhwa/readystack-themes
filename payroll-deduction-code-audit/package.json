{
  "name": "payroll-deduction-code-audit",
  "displayName": "Payroll Deduction Code Audit 2026",
  "description": "Audits a payroll deduction code map before January W-2 filing: pre-tax flags, Box 12 letters, duplicate codes, stale plan years. Every broken line is named with its line number.",
  "version": "1.0.3",
  "publisher": "readystack",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "payroll",
    "deduction code",
    "W-2 Box 12",
    "pre-tax",
    "HRIS",
    "csv lint",
    "plan year"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "payrollDeductionCodeAudit.checkFile",
        "title": "Payroll Deduction Code Audit 2026: Check this file",
        "category": "Payroll Deduction Code Audit 2026"
      },
      {
        "command": "payrollDeductionCodeAudit.checkWorkspace",
        "title": "Payroll Deduction Code Audit 2026: Sweep workspace and write report (licence)",
        "category": "Payroll Deduction Code Audit 2026"
      },
      {
        "command": "payrollDeductionCodeAudit.enterKey",
        "title": "Payroll Deduction Code Audit 2026: Enter licence key",
        "category": "Payroll Deduction Code Audit 2026"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmshinhwa/readystack-themes.git",
    "directory": "payroll-deduction-code-audit"
  },
  "homepage": "https://getreadystack.com/tools/payroll-deduction-code-audit"
}