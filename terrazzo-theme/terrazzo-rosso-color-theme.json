  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#A08F87",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "comment.block.documentation storage.type",
        "comment keyword.codetag",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#B09F97",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.fn",
        "keyword.other.rust",
        "storage.type.function",
        "storage.type.class",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#F39CC2"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#BCADA5"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#BCADA5"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw.string"
      ],
      "settings": {
        "foreground": "#E6C67D"
      }
    },
    {
      "name": "Escape / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#88D5D4"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#F39CC2"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other",
        "support.constant",
        "constant.other.caps",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#A0BFEE"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "storage.type.primitive",
        "storage.type.numeric.go",
        "storage.type.string.go",
        "storage.type.boolean.go",
        "support.type.primitive",
        "entity.name.namespace",
        "entity.name.type.module",
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#8FD3AB"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.function.macro",
        "support.function.builtin",
        "entity.name.function.decorator",
        "meta.function-call.generic",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#F6AC72"
      }
    },
    {
      "name": "Decorator / attribute",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "meta.attribute.rust",
        "storage.type.annotation",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#C6B0E8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#C6B0E8"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#EDE2DB"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "entity.other.attribute-name.class.css",
        "meta.field.declaration",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#DDCFC7"
      }
    },
    {
      "name": "JSON / YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#F39CC2"
      }
    },
    {
      "name": "Lifetime / label",
      "scope": [
        "entity.name.type.lifetime",
        "storage.modifier.lifetime",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#C6B0E8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#F39CC2"
      }
    },
    {
      "name": "HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8FD3AB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#F6AC72"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "meta.property-value",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#A0BFEE"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#F39CC2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#EDE2DB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#EDE2DB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#F6AC72"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#E6C67D"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#A08F87",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#A0BFEE"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#8FD3AB"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#F28A80"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#E6C67D"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F28A80",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E6C67D",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8FD3AB",
    "class": "#8FD3AB",
    "enum": "#8FD3AB",
    "interface": "#8FD3AB",
    "struct": "#8FD3AB",
    "typeParameter": {
      "foreground": "#8FD3AB",
      "italic": true
    },
    "type": "#8FD3AB",
    "parameter": "#C6B0E8",
    "variable": "#EDE2DB",
    "variable.readonly": "#A0BFEE",
    "variable.defaultLibrary": "#A0BFEE",
    "property": "#DDCFC7",
    "property.readonly": "#DDCFC7",
    "enumMember": "#A0BFEE",
    "function": "#F6AC72",
    "method": "#F6AC72",
    "macro": "#F6AC72",
    "function.defaultLibrary": "#F6AC72",
    "keyword": "#F39CC2",
    "string": "#E6C67D",
    "number": "#A0BFEE",
    "regexp": "#88D5D4",
    "operator": "#BCADA5",
    "decorator": {
      "foreground": "#C6B0E8",
      "italic": true
    },
    "label": "#C6B0E8",
    "selfKeyword": "#F39CC2",
    "lifetime": {
      "foreground": "#C6B0E8",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}