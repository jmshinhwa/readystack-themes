{
  "resourceType": "CapabilityStatement",
  "id": "payer-patient-access",
  "url": "https://fhir.example-health-plan.com/metadata",
  "version": "1.0.4",
  "name": "ExamplePlanPatientAccess",
  "title": "Example Health Plan - Patient Access API (CMS-9115-F build)",
  "status": "active",
  "date": "2021-07-01",
  "publisher": "Example Health Plan, Medicare Advantage contract H1234",
  "kind": "instance",
  "implementation": {
    "description": "Patient Access and Provider Directory APIs delivered for the 2021 interoperability rule",
    "url": "https://fhir.example-health-plan.com/r4"
  },
  "fhirVersion": "4.0.1",
  "format": ["application/fhir+json"],
  "implementationGuide": [
    "http://hl7.org/fhir/us/carin-bb/ImplementationGuide/hl7.fhir.us.carin-bb"
  ],
  "rest": [
    {
      "mode": "server",
      "security": {
        "service": [
          {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/restful-security-service", "code": "SMART-on-FHIR"}]}
        ],
        "extension": [
          {
            "url": "http://fhir-registry.smarthealthit.org/StructureDefinition/oauth-uris",
            "extension": [
              {"url": "authorize", "valueUri": "http://auth.example-health-plan.com/authorize"},
              {"url": "token", "valueUri": "https://auth.example-health-plan.com/token"}
            ]
          }
        ]
      },
      "resource": [
        {
          "type": "Patient",
          "supportedProfile": ["http://hl7.org/fhir/us/carin-bb/StructureDefinition/C4BB-Patient"],
          "interaction": [{"code": "read"}, {"code": "search-type"}]
        },
        {
          "type": "Coverage",
          "supportedProfile": ["http://hl7.org/fhir/us/carin-bb/StructureDefinition/C4BB-Coverage"],
          "interaction": [{"code": "read"}, {"code": "search-type"}]
        },
        {
          "type": "ExplanationOfBenefit",
          "supportedProfile": ["http://hl7.org/fhir/us/carin-bb/StructureDefinition/C4BB-ExplanationOfBenefit"],
          "interaction": [{"code": "read"}, {"code": "search-type"}]
        },
        {
          "type": "Organization",
          "interaction": [{"code": "read"}, {"code": "search-type"}]
        },
        {
          "type": "Practitioner",
          "interaction": [{"code": "read"}, {"code": "search-type"}]
        },
        {
          "type": "InsurancePlan",
          "interaction": [{"code": "read"}, {"code": "search-type"}]
        }
      ]
    }
  ]
}
