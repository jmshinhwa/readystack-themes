{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jmshinhwa/privacy-manifest-lint",
  "description": "Checks PrivacyInfo.xcprivacy and your C#, Dart, JS, Swift and Kotlin source for Apple required-reaso",
  "repository": {
    "url": "https://github.com/jmshinhwa/readystack-themes",
    "source": "github"
  },
  "version": "0.1.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@readystack/privacy-manifest-lint",
      "version": "0.1.3",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp",
          "description": "run as an MCP server (stdio)"
        }
      ]
    }
  ]
}